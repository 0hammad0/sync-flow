# Firebase — public (client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — from the service-account JSON
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@<project-id>.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=syncflow-files
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare GraphQL Analytics (admin Files & Health: R2 bucket totals).
# Optional: without them the admin shows "R2 totals need CF_API_TOKEN".
# Token permission: Account > Account Analytics > Read (nothing else).
CF_ACCOUNT_ID=
CF_API_TOKEN=

# SMTP (optional — used for "Send via email" share links)
SMTP_USER=you@gmail.com
SMTP_PASS=<gmail-app-password>

# Optional: production URL (used for generating share links)
# If not set, defaults to localhost:3000 or the Vercel URL
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# OpenRouter AI features (chat smart replies, summaries, rewrite, translate, explain)
# Optional — AI controls only appear when this key is set. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: primary model (falls back through free models automatically)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: Google Gemini answers when OpenRouter fails (also turns AI on by itself). Key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional: Gemini model (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# Optional: disable specific tasks, e.g. "replies,translate"
# AI_TASKS_DISABLED=
# Optional: AI requests per minute per IP (default 15)
# AI_RATE_LIMIT=15
# Optional: total AI requests per day per server instance (default 500)
# AI_DAILY_LIMIT=500

# Required in production: protects /api/cleanup (the daily Vercel cron).
# Vercel sends it as "Authorization: Bearer <value>". Use 16+ random letters/digits.
# Without it the cleanup route refuses every call.
CRON_SECRET=

# Admin Files screen: key for the opaque file ids in admin URLs and audit rows.
# A share file's id is its download token, so the admin never shows it; ids are
# encrypted with this key instead. Server only, never NEXT_PUBLIC_. 32+ random
# bytes as base64, e.g. `openssl rand -base64 32`. Without it the Files screen
# shows a setup message. Changing it makes old file links in the audit log stop
# resolving (the audit rows themselves are unchanged).
ADMIN_FILE_ID_KEY=
