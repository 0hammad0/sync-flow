# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Bucket Name (must match the bucket created in Supabase)
STORAGE_BUCKET=file-transfer-bucket

# Optional: Production URL (used for generating share links)
# If not set, defaults to localhost:3000 or Vercel URL
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# OpenRouter AI features (chat smart replies, summaries, rewrite, translate, explain)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: primary model (falls back through free models automatically)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: disable specific tasks, e.g. "replies,translate"
# AI_TASKS_DISABLED=
# Optional: AI requests per minute per IP (default 15)
# AI_RATE_LIMIT=15
