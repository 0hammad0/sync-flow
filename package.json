  "license": "MIT",
  "keywords": [
    "file-sharing",
    "end-to-end-encryption",
    "nextjs",
    "firebase",
    "cloudflare-r2",
    "chat",
    "qr-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0hammad0/sync-flow.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@tanstack/react-table": "9.3.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "nuqs": "2.10.3",
    "qrcode.react": "^4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-textarea-autosize": "^8.5.9",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
